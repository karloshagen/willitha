# Postgres connection. Vercel Marketplace Neon sets both; either one is enough.
# DATABASE_URL is preferred when both are present.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require

# Public site origin used for canonical URLs, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://willitha.au

# Bearer token for /api/admin/*. Generate a long random string. Never commit it.
ADMIN_TOKEN=

# Resend. Signup still saves to the database if these are unset.
# RESEND_AUDIENCE_ID is the Resend segment id (audiences were renamed to segments).
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Sponsor enquiry email. Sent only when RESEND_API_KEY, EMAIL_FROM, and at least one recipient are set.
EMAIL_FROM=Will It HA <newsletter@willitha.au>
OWNER_EMAIL=
CEO_EMAIL=
